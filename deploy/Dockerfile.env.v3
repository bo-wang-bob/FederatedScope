# Environment-only update of the supplied Dockerfile.v2 image, not an app image.
# Requires an existing federated-train-env:v2 image and network during build.
# docker build --pull=false -f backend/deploy/Dockerfile.env.v3 -t federated-train-env:v3 .
FROM federated-train-env:v2

# Keep the existing PyTorch/CUDA packages; add actual multiformat image decoding.
RUN python3 -m pip install --no-cache-dir --disable-pip-version-check \
    Pillow==11.3.0 pillow-heif==0.22.0 \
    && python3 -m pip check

# Fail if v2 lacks existing training dependencies. Build checks need no GPU.
RUN python3 -c "import sys; assert sys.version_info[:2] == (3, 9), 'Expected CPython 3.9'; import torch, torchvision, open_clip, timm, safetensors, ftfy, regex, wcwidth, dill, numpy, scipy, sklearn, matplotlib, yaml, yacs, psutil, grpc, fvcore, pympler, PIL, pillow_heif; assert torch.version.cuda is not None, 'CUDA-enabled PyTorch required'; from PIL import features; assert all(features.check(x) for x in ['jpg', 'webp', 'libtiff', 'jpg_2000', 'avif']), 'Required image codec unavailable'; print('Environment imports OK; CUDA build:', torch.version.cuda)"

WORKDIR /workspace
CMD ["bash"]
