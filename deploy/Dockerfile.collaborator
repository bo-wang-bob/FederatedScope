# Standalone Linux amd64 environment for the current platform.
# Send this ONE file to the image builder. No source, wheelhouse or v1/v2 image needed.
# Online build: docker build --platform linux/amd64 -f Dockerfile.collaborator -t federated-train-env:20260919 .
# Code, resources and saved experiments are mounted at runtime, not copied here.
FROM node:22-bookworm-slim AS node
FROM python:3.9.23-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    FEDERATEDSCOPE_GGEUR_LIGHTWEIGHT=1 MPLBACKEND=Agg

# Node/npm are available if the collaborator needs to build frontend/dist.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 libstdc++6 fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# CUDA-enabled PyTorch; do not install host NVIDIA drivers in the image.
RUN python3 -m pip install --no-cache-dir pip==25.2 setuptools==80.9.0 wheel==0.45.1 \
    && python3 -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu121 \
       torch==2.5.1+cu121 torchvision==0.20.1+cu121

# Inlined deploy/requirements-runtime.lock: no extra requirements file required.
RUN python3 -m pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cu121 \
    certifi==2025.11.12 \
    charset-normalizer==3.4.4 \
    contourpy==1.2.1 \
    cycler==0.12.1 \
    dill==0.3.6 \
    filelock==3.7.1 \
    fonttools==4.60.1 \
    fsspec==2023.6.0 \
    ftfy==6.3.1 \
    fvcore==0.1.5.post20221221 \
    grpcio==1.76.0 \
    huggingface-hub==0.10.1 \
    idna==3.11 \
    importlib-resources==6.5.2 \
    iopath==0.1.10 \
    jinja2==3.1.6 \
    joblib==1.5.2 \
    kiwisolver==1.4.7 \
    markupsafe==3.0.3 \
    matplotlib==3.8.4 \
    mpmath==1.3.0 \
    networkx==3.2.1 \
    numpy==1.22.4 \
    nvidia-cublas-cu12==12.1.3.1 \
    nvidia-cuda-cupti-cu12==12.1.105 \
    nvidia-cuda-nvrtc-cu12==12.1.105 \
    nvidia-cuda-runtime-cu12==12.1.105 \
    nvidia-cudnn-cu12==9.1.0.70 \
    nvidia-cufft-cu12==11.0.2.54 \
    nvidia-curand-cu12==10.3.2.106 \
    nvidia-cusolver-cu12==11.4.5.107 \
    nvidia-cusparse-cu12==12.1.0.106 \
    nvidia-nccl-cu12==2.21.5 \
    nvidia-nvjitlink-cu12==12.9.86 \
    nvidia-nvtx-cu12==12.1.105 \
    open-clip-torch==3.2.0 \
    packaging==25.0 \
    pillow==11.3.0 \
    pillow-heif==0.22.0 \
    portalocker==3.2.0 \
    protobuf==3.19.4 \
    psutil==7.2.1 \
    pympler==1.1 \
    pyparsing==3.2.5 \
    python-dateutil==2.9.0.post0 \
    pyyaml==6.0.3 \
    regex==2025.11.3 \
    requests==2.32.5 \
    safetensors==0.7.0 \
    scikit-learn==1.0.2 \
    scipy==1.7.3 \
    six==1.17.0 \
    sympy==1.13.1 \
    tabulate==0.9.0 \
    termcolor==1.1.0 \
    threadpoolctl==3.6.0 \
    timm==1.0.24 \
    torch==2.5.1+cu121 \
    torchvision==0.20.1+cu121 \
    tqdm==4.67.1 \
    triton==3.1.0 \
    typing-extensions==4.15.0 \
    urllib3==1.26.20 \
    wcwidth==0.2.14 \
    yacs==0.1.8 \
    zipp==3.23.0 \
    && python3 -m pip check

# Build-time checks do not require a GPU. Runtime GPU access is checked at launch.
RUN python3 -c "import torch, torchvision, open_clip, timm, safetensors, ftfy, regex, wcwidth, dill, numpy, scipy, sklearn, matplotlib, yaml, yacs, psutil, grpc, fvcore, pympler, PIL, pillow_heif; assert torch.version.cuda == '12.1'; from PIL import features; assert all(features.check(x) for x in ['jpg', 'webp', 'libtiff', 'jpg_2000', 'avif']), 'Missing image codec'; print('Runtime dependencies OK')" \
    && node --version && npm --version

WORKDIR /workspace
EXPOSE 8002
CMD ["bash"]

